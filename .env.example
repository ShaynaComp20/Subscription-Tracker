# Public URL of the app (used for the OAuth redirect and links in reminder emails)
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
# Authorized redirect URI must be: ${APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string used to sign session cookies:  openssl rand -hex 32
SESSION_SECRET=

# Shared secret for triggering reminders over HTTP: GET /api/cron/reminders with header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# How many days before a charge to send the reminder (1 = "tomorrow you will be charged")
REMIND_DAYS_BEFORE=1

# Timezone used to decide what "today" and "tomorrow" mean
TZ=UTC

# SQLite file location
DATABASE_PATH=./data/tracker.db
